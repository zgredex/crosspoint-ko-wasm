# CMake build outputs
build/
build-wasm/
# reference-build trees (compiled from the pinned CrossPoint-KO checkout)
build-oracle/
build-oracle-perturbed/

# Python caches
__pycache__/
*.pyc

# Commercial test book — not redistributable
web/demo.epub

# Deploy artifact (generated by scripts/build_dist.sh — never committed)
dist/
*.zip

# Wrangler local state from `wrangler pages deploy`
.wrangler/

# macOS
.DS_Store

# EPD2 blobs are DERIVED (build/export_external_font). A build that externalizes a face stages the
# blob into dist/ at package time; git tracks the generator, not 5 MB of output.
*.epd2

# Generated engine artifacts — NEVER tracked in web/ any more. web/ is source only; dist/ takes the
# engine straight from build-wasm/ (see scripts/build_dist.sh). The tracked copies that used to live
# here are exactly what caused the 2026-09-17 stale-wasm deploy: dist/ was refreshed from web/'s
# older copy while the build directory held a newer one. scripts/stage_dev.sh puts them back locally
# when you want to serve web/ with a plain static server.
web/ko_xtch_wasm.js
web/ko_xtch_wasm.wasm
web/ko_build_info.js
web/ft_wasm.js
web/ft_wasm.wasm

# Local fixtures too large to track (regenerated on demand):
#   web/demo.epub       60 spines / 1,690 pages / 162 MB container
#   web/demo-large.epub 80 MB, built to measure the open path transfer and copy costs
web/demo.epub
web/demo-large.epub
